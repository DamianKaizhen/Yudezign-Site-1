# YuDezign Website - Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# VERCEL BLOB STORAGE (Automatically provided by Vercel)
# =============================================================================
# When you link a Vercel Blob store to your project, Vercel automatically
# provides this token. You don't need to manually set it in production.
#
# Current Blob Store Configuration:
# - Store ID: store_OwcahJZz8KIDIUwp
# - Storage Region: iad1 (US East)
# - Base URL: https://owcahjzz8kidiuwp.public.blob.vercel-storage.com
# - Store Name: yudezign-blob
#
# For local development, get the token from Vercel Dashboard:
# https://vercel.com/dashboard → Storage → yudezign-blob → Connect
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXX

# =============================================================================
# ADMIN AUTHENTICATION
# =============================================================================
# Admin panel password (required for /admin access)
VITE_ADMIN_PASSWORD=your_secure_admin_password

# =============================================================================
# GOOGLE ANALYTICS (Optional)
# =============================================================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# GITHUB AUTO-COMMIT (Required - for admin panel)
# =============================================================================
# Personal Access Token with 'repo' scope
# Get it from: https://github.com/settings/tokens
#
# Used by the admin API routes to commit data files (src/data/*.ts) AND to mirror
# admin-uploaded images into the repo. When an image is uploaded through an admin
# form (portfolio/team/finishes/testimonials), /api/upload-attachment stores it on
# Vercel Blob (backup) and ALSO commits the binary to public/<folder>/<file> using
# these same credentials — the committed /public path becomes the canonical image
# src, so images can also be added locally and committed to git. No extra env vars
# are needed for image mirroring.
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_OWNER=DamianKaizhen
GITHUB_REPO=Yudezign-Site-1
GITHUB_BRANCH=claude/yudeZign-website-build-011CUhoKjETu4Af6EiMHqd6Z

# =============================================================================
# ROOM VISUALIZER - AI IMAGE GENERATION (Google Gemini)
# =============================================================================
# Google AI Studio (Gemini API) key used to generate room visualizations directly
# in the serverless function via the gemini-3-pro-image-preview (Nano Banana Pro)
# model — the in-house replacement for the n8n workflow. Use a billing-enabled
# key from the same Google account the n8n workflow uses (YuDezign-GeminiAccount).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: which Gemini image model to use. Defaults to gemini-2.5-flash-image
# (Nano Banana), which is available on Google's free tier. For premium quality
# set this to gemini-3-pro-image-preview (Nano Banana Pro) — requires a
# billing-enabled Google project.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# =============================================================================
# VISUALIZER WEBHOOK (n8n automation) — FALLBACK ONLY
# =============================================================================
# The visualizer now calls Gemini directly (see GEMINI_API_KEY above). This n8n
# webhook is used only as an automatic fallback if the direct call fails/times out.
# Webhook URL for room visualizer form submissions
VISUALIZER_WEBHOOK_URL=https://n8n.kaizhen8n.cloud/webhook/room-visualizer
# Basic auth credentials for webhook (if configured)
VISUALIZER_WEBHOOK_USER=YudezignSiteAuth
VISUALIZER_WEBHOOK_PASSWORD=your_webhook_password_here

# =============================================================================
# CONTACT FORM EMAIL NOTIFICATIONS (SMTP) — in-house replacement for n8n
# =============================================================================
# The contact form (/contact) posts to /api/contact-notify, which sends:
#   1. A "Website Request" email to CONTACT_NOTIFY_TO (your team inbox).
#   2. A confirmation email to the customer (only if they gave a valid email).
#
# NOTE: sending mail requires SMTP, not IMAP. IMAP only reads a mailbox — it
# cannot send. Most hosts expose both on the same login; use the SMTP host/port.
# Common ports: 465 (SSL/implicit TLS) or 587 (STARTTLS).
#
# If these are left unset, the form still works and stores the lead in the admin
# panel; it just skips the emails (logged as a warning).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_USER=orders@yudezign.com
SMTP_PASSWORD=your_mailbox_password_or_app_password
# Optional overrides:
SMTP_FROM=orders@yudezign.com
SMTP_FROM_NAME=YuDezign Website
# Internal inbox that receives the "Website Request" email:
CONTACT_NOTIFY_TO=orders@yudezign.com

# =============================================================================
# CONTACT FORM SPAM PROTECTION — Cloudflare Turnstile (invisible CAPTCHA)
# =============================================================================
# The contact form (/contact) is gated by /api/contact-submit, which verifies a
# Cloudflare Turnstile token server-side (plus honeypot + timing + content
# filters). Create a free widget at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
# Add your site's domain(s) to the widget, then copy the two keys below.
#
# If these are left unset, the form still works — the CAPTCHA layer is skipped
# (honeypot + timing + content filters still apply).
#
# Public site key — safe to expose; used by the browser widget (VITE_ = client):
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
# Secret key — server-side only; used by /api/contact-submit to verify tokens:
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key

# =============================================================================
# DEVELOPMENT (Optional)
# =============================================================================
# Enable extra debugging in development
VITE_DEV_MODE=true
